land"},{"id":"Q812","name":"佛罗里达 Florida","orig":"La Pascua Florida","lang":"西班牙语","zh":"复活节的鲜花盛开","kind":"地区","lat":28.133,"lng":-81.632,"wiki":"Florida"},{"id":"Q11299","name":"曼哈顿 Manhattan","orig":"Mannahatta","lang":"伦那佩语","zh":"多丘陵的岛","kind":"地区","lat":40.728,"lng":-73.994,"wiki":"Manhattan"},{"id":"Q35381","name":"科伦坡 Colombo","orig":"Kolamba","lang":"僧伽罗语","zh":"带芒果树的港口","kind":"城市","lat":6.927,"lng":79.861,"wiki":"Colombo"},{"id":"Q1246","name":"科索沃 Kosovo","orig":"Kosovo Polje","lang":"塞尔维亚语","zh":"黑鸟之原","kind":"地区","lat":42.55,"lng":20.833,"wiki":"Kosovo"}],"langNotes":{"爱尔兰语":"盖尔语地名（Dubh、Baile、Kil-）集中在爱尔兰岛，也随移民散到北美和澳洲。","古诺尔斯语":"维京人的语言：-vik（海湾）、-by（村）、-borg 等词尾沿北大西洋岛屿和北欧海岸分布。","古英语":"英格兰的地名词尾 -ford（渡口）、-pool（水塘）、-ham（村）几乎只出现在英格兰及其殖民地。","法语":"法国的殖民足迹：加拿大魁北克、密西西比河流域（Detroit、Baton Rouge）和西非、中非。","米亚米-伊利诺伊语":"美洲原住民语言留下的地名，多在大湖区和密西西比河上游一带。","西班牙语":"西班牙殖民美洲：圣徒名（San/Santa）、宗教词汇一路铺到加州、墨西哥、中美和南美。","阿尔衮琴语":"阿尔衮琴语族分布在加拿大东部和北美大湖区，渥太华河一带至今留有它的地名。","夏威夷语":"波利尼西亚语言，地名多元音、少辅音，集中在太平洋岛屿。","葡萄牙语":"大航海时代的葡萄牙留下了大西洋沿岸地名：巴西、几内亚湾、佛得角和摩洛哥海岸。","纳瓦特尔语":"阿兹特克人的语言，-co、-tlan 词尾集中在墨西哥中南部。","绍纳语":"班图语系的绍纳语，主要在津巴布韦高原一带。","英语":"英语地名多是近代殖民者所起：自由之城、基督城等词汇构成的名字常见于殖民地。","阿拉伯语":"阿拉伯语地名（al-、Dar、Jabal）随伊斯兰扩张，北非、中东、西班牙南部和波斯湾一线最密。","马赛语":"东非尼罗特语系，马赛人主要在肯尼亚和坦桑尼亚的大裂谷一带。","阿姆哈拉语":"埃塞俄比亚的闪米特语言，只在埃塞俄比亚高原一带通行。","威尼斯语":"威尼斯共和国曾统治亚得里亚海东岸，Monte Negro 就是它留下的名字。","塞尔维亚语":"南斯拉夫语族，主要分布在巴尔干半岛的塞尔维亚及其周边。","希腊语":"希腊语的足迹覆盖东地中海、黑海沿岸，保加利亚、土耳其、意大利南部都有。","古日耳曼语":"早期日耳曼语地名，-burg（堡）在德语区和卢森堡一带最常见。","拉丁语":"罗马帝国的遗产：Nova、Trans-、-ia 等词形遍布欧洲和后来的殖民地。","德语":"德语地名词尾 -burg、-bruck、-berg 集中在德国、奥地利和瑞士。","古高地德语":"中世纪南德语，-furt（渡口）、München 这类名字多在德国南部与中部。","古荷兰语":"低地国家的早期名字，-dam 和 -brug 一类词尾沿尼德兰低地分布。","古希腊语":"Neapolis、Tripolis 这样的 -polis（城）名字，是希腊殖民者沿地中海岸建立的城市。","乌克兰语":"东斯拉夫语言，名字多用 -ль、-ів 词尾，集中在乌克兰。","俄语":"“-град”“-ск”结尾的城镇沿西伯利亚铁路和俄国扩张路线排开，直到太平洋。","古东斯拉夫语":"古罗斯的名字，Novgorod（新城）是俄罗斯最早的城市之一。","中世纪希腊语":"拜占庭时代的希腊语，主要在今天的土耳其和巴尔干。","格鲁吉亚语":"南高加索的卡特维尔语系，只在格鲁吉亚使用。","腓尼基语":"腓尼基人的闪米特语言，地名沿黎巴嫩海岸和他们的地中海殖民地分布。","希伯来语":"现代希伯来语地名集中在以色列。","乌尔都语":"乌尔都语是巴基斯坦的国语，也通行在印度北部。","乌尔都语／波斯语":"波斯语词汇随莫卧儿帝国进入南亚，-stan、-abad 词尾一路延伸到中亚。","梵语":"梵语文化圈：印度、尼泊尔，以及东南亚受印度化影响的城市（-pura 即“城”）。","马拉地语":"印度西部马哈拉施特拉邦的语言。","波斯语／乌尔都语":"-abad（居所/城）是波斯化的标志，常见于南亚和中亚。","马来语":"马来语地名（Kuala 河口、Pulau 岛）集中在马来半岛和印尼群岛。","缅甸语":"汉藏语系缅语支，只在缅甸及其周边使用。","高棉语":"柬埔寨的语言，Phnom（山丘）是高棉语的标志词。","老挝语":"老挝的语言，Viang（城）出现在老挝和泰国东北部。","蒙古语":"蒙古高原的名字：Ulaan（红）、Khot（城）在蒙古国和内蒙古。","突厥语":"突厥语族沿中亚草原向西延伸：-kent（城）、-tash（石）。","土库曼语／波斯语":"波斯化的突厥语区，在中亚南部的卡拉库姆沙漠沿线。","塔吉克语":"塔吉克语是波斯语的一支，在中亚南部山地使用。","伦那佩语":"特拉华人的语言，原住民地名散在美国东北部。","僧伽罗语":"斯里兰卡的主要语言。"}}